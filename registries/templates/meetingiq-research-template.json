{
  "template_kind": "output",
  "fields": {
    "account": { "source": "node.account.entity" },
    "contacts": { "source": "node.contacts.records" },
    "recent_activity": { "source": "node.activity.records" },
    "summary": {
      "static": {
        "headline": "Company research summary",
        "format": "structured_brief"
      }
    },
    "provenance": {
      "static": { "template": "meetingiq-research-template", "experience": "meetingiq.company-research" }
    }
  },
  "output_schema": {
    "required": ["account", "summary", "provenance"]
  }
}
