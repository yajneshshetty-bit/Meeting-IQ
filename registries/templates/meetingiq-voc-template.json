{
  "template_kind": "output",
  "fields": {
    "account": { "source": "node.account.entity" },
    "communications": { "source": "node.communications.records" },
    "themes": {
      "transform": "extract_themes",
      "from": "node.communications.records",
      "field": "body"
    },
    "provenance": {
      "static": { "template": "meetingiq-voc-template", "experience": "meetingiq.voice-of-customer" }
    }
  },
  "output_schema": {
    "required": ["account", "themes", "provenance"]
  }
}
